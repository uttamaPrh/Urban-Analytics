{
  "name": "urban-analytics",
  "version": "0.1.0",
  "private": true,
  "description": "Geospatial Urban Analytics Platform — Vite + React + TypeScript",
  "scripts": {
    "dev": "node scripts/dev.js",
    "frontend": "vite --host 127.0.0.1",
    "backend": "python -m uvicorn backend.app:app --reload --host 127.0.0.1 --port 8001",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "download-geodata": "node scripts/download-geodata.js"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "globe.gl": "^2.46.1",
    "maplibre-gl": "^2.4.0",
    "deck.gl": "^8.9.0",
    "@deck.gl/layers": "^8.9.0",
    "@deck.gl/react": "^8.9.0",
    "zustand": "^4.4.0",
    "@tanstack/react-query": "^5.0.0",
    "recharts": "^2.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^1.2.1",
    "tailwind-merge": "^1.14.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vite": "^5.1.0",
    "@vitejs/plugin-react": "^4.0.0",
    "postcss": "^8.4.21",
    "autoprefixer": "^10.4.14",
    "tailwindcss": "^3.4.7",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@types/maplibre-gl": "^1.14.0",
    "@types/node": "^20.0.0"
  },
  "engines": {
    "node": ">=18"
  },
